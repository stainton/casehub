FROM debian:stable-slim

RUN apt-get update && apt-get install -y --no-install-recommends \
    ca-certificates \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /app

# Built on the host with: GOOS=linux GOARCH=amd64 CGO_ENABLED=0 go build -o out/casehub-manager ./cmd/manager
# This is cmd/manager/main.go, the frontend-less entry point for the real
# deployment: manager owns Postgres directly and serves no static files. For
# the single-container image that bundles the debug/demo frontend, see
# build/Dockerfile.manager-mock (built by build/mock-release.sh).
COPY out/casehub-manager /app/casehub-manager

EXPOSE 8081

ENTRYPOINT ["/app/casehub-manager"]
# Defaults match cmd/manager/app/flag.go; override at `docker run` time, e.g.:
#   docker run -p 8081:8081 casehub-manager -db-host=postgres -db-password=...
CMD ["-db-host=postgres"]
